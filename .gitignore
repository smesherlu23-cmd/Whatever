# Настройки с паролями. Пример без секретов — .env.example.
.env
.env.*
!.env.example

# Зависимости и сборка
node_modules/
.venv/
dist/
*.tsbuildinfo

# Картинки и вложения досок при разработке (WHATEVER_FILES_DIR)
backend/data/

# Резервные копии на сервере (WHATEVER_BACKUP_DIR)
backups/

# Сквозные тесты: вход пользователей и отчёты Playwright
frontend/e2e/.auth/
frontend/test-results/
frontend/playwright-report/

# Кэши инструментов
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Отчёты о покрытии
.coverage
.coverage.*
htmlcov/
coverage/

# Системные файлы и редакторы
.DS_Store
.idea/
*.swp
